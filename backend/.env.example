# MongoDB Atlas connection string (get this from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthsense?retryWrites=true&w=majority

# Any long random string works. Generate one at: https://randomkeygen.com (use a "CodeIgniter Encryption Keys" one)
JWT_SECRET=replace_this_with_a_long_random_string

# Token expiry
JWT_EXPIRES_IN=7d

# Server port
PORT=5000

# Frontend URL (for CORS) - update when you deploy
CLIENT_URL=http://localhost:5173

# FastAPI ML microservice URL (Module 5 — Disease Risk Prediction)
ML_SERVICE_URL=http://localhost:8000

# Email for "Forgot password" (optional in development: if empty, the reset link is printed in the backend terminal)
# Gmail: turn on 2-Step Verification, then create an App password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=HealthSense AI <your_email@gmail.com>


